# Copy this file to .env and adjust the values before starting the stack.
# monitor_service.sh loads .env automatically if it exists.

# Elastic Stack version (Elasticsearch, Logstash, Kibana, Elastic Agent)
# Use the 8.19.x line instead if you are upgrading an existing 8.x cluster.
ELASTIC_VERSION=9.4.3

# Password for the built-in "elastic" superuser
ELASTIC_PASSWORD=changeme

# Password for the built-in "kibana_system" user (used by Kibana)
KIBANA_PASSWORD=changeme

# Password Logstash uses to write to Elasticsearch
LOGSTASH_ES_PASSWORD=changeme

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
